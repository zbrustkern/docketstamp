# DocketStamp local staging configuration
# Copy to .env.local. Never commit local credentials or prefix secrets with NEXT_PUBLIC_.
# Hosted secrets belong in Google Cloud Secret Manager. See apphosting.staging.yaml.

# Firebase: local development defaults to the DocketStamp staging project.
# Complete, verified public web app identities live in lib/firebase-config.ts.
# Optional NEXT_PUBLIC_FIREBASE_* overrides must match that project's entire identity.
ENVIRONMENT=staging
FIREBASE_PROJECT_ID=docketstamp-staging
NEXT_PUBLIC_FIREBASE_PROJECT_ID=docketstamp-staging
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefer Application Default Credentials for live local Firestore access.
# FIREBASE_CLIENT_EMAIL=<service-account-in-docketstamp-staging>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# For offline local development only; forbidden in production:
# USE_MOCK_FIRESTORE=true

# Stripe: test credentials only in staging. Store all private keys server-side.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Provision the three service tiers using npm run stripe:bootstrap.
STRIPE_PRICE_ID_FIRST_CLASS=price_...
STRIPE_PRICE_ID_CERTIFIED=price_...
STRIPE_PRICE_ID_CERTIFIED_RETURN_RECEIPT=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_FIRST_CLASS=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_CERTIFIED=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_CERTIFIED_RETURN_RECEIPT=price_...

# Lob: deterministic address validation and test dispatch prevent staging postage fees.
LOB_ENV=staging_mock_cass
LOB_DISPATCH_API_KEY=test_...
LOB_WEBHOOK_SECRET=...
# To verify real addresses, configure the separate address key intentionally:
# LOB_ADDRESS_VERIFICATION_KEY=live_...

# Admin sessions: provide a random server-only signing key.
ADMIN_SESSION_SIGNING_KEY=replace-with-a-random-signing-key
# ADMIN_AUTHORIZED_EMAILS=<explicitly-authorized-admin-addresses>

# Optional transactional email; verified DocketStamp sender identities only.
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=alerts@docketstamp.com
# RESEND_DISPATCH_FROM_EMAIL=dispatch@docketstamp.com

# One-time notice deadline reminders. Generate independent random secrets (32+ characters),
# keep them server-only in Secret Manager, and do not configure an external schedule until reviewed.
# REMINDER_UNSUBSCRIBE_SECRET=<random-server-only-secret-at-least-32-characters>
# REMINDER_SCHEDULER_SECRET=<different-random-server-only-secret-at-least-32-characters>
# RESEND_API_KEY=... # required for reminder delivery; without it scheduler attempts fail closed

# Analytics destinations require independently verified DocketStamp account ownership.
# NEXT_PUBLIC_GOOGLE_TAG_ID=...
# NEXT_PUBLIC_GOOGLE_ADS_ID=...
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=...
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=...
# NEXT_PUBLIC_META_PIXEL_ID=...
# META_CONVERSIONS_API_ACCESS_TOKEN=...
# META_TEST_EVENT_CODE=...
# NEXT_PUBLIC_META_DOMAIN_VERIFICATION=...
# Current inherited analytics fallbacks are inventoried in docs/DOCKETSTAMP_LEGACY_REPLACEMENT_PLAN.md.

# Enable only after an external scheduler and delivery have been configured and verified.
# REMINDER_DELIVERY_ENABLED=true
