# ==============================================================================
# sendmynotes.com - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env, .env.local, or service account keys to git.
# 2. NEVER prefix private API keys with NEXT_PUBLIC_ (this leaks them to browser bundles).
# 3. For Production deployments to Firebase App Hosting, use Google Cloud Secret Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Stripe Configuration (Financial Transactions)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Secret key used for creating PaymentIntents & charging $6.50
STRIPE_SECRET_KEY=sk_test_...

# [SERVER ONLY] Webhook signing secret used to verify payment_intent.succeeded events
STRIPE_WEBHOOK_SECRET=whsec_...

# [CLIENT PUBLIC] Publishable key loaded in browser for Stripe Elements widget
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# 2. Handwrytten Fulfillment API v2 (Physical Robotic Pen Inking)
# ------------------------------------------------------------------------------
# [SERVER ONLY] API Key for ordering physical cards & postage (no "Bearer " prefix)
HANDWRYTTEN_API_KEY=your_handwrytten_api_key_here

# ------------------------------------------------------------------------------
# 3. AI Cover Art Generation (Google Gemini / Imagen 3 or Nano Banana)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Google AI Studio key for native Imagen 3 generation
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# [SERVER ONLY] Alternative Nano Banana AI Art generation key (optional)
NANO_BANANA_API_KEY=your_nano_banana_api_key_here

# ------------------------------------------------------------------------------
# 4. Firebase Configuration
# ------------------------------------------------------------------------------
# In Firebase App Hosting / Cloud Run, authentication is automatic via Cloud IAM Application Default Credentials.
# For local development with live Firestore, you can optionally provide:
FIREBASE_PROJECT_ID=sendmynotes-2a417
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sendmynotes-2a417.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ------------------------------------------------------------------------------
# 5. Google Ads & GA4 Analytics (Conversion Tracking & Audience Building)
# ------------------------------------------------------------------------------
# [CLIENT PUBLIC] Google Ads Account ID (fallback hardcoded in lib/google-ads.ts)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18474411963

# [CLIENT PUBLIC] Google Ads Conversion Label — REQUIRED for conversion tracking.
# Without this, purchase conversion events fire without a label and will NOT match
# any configured conversion action in Google Ads. Smart Bidding will have no signal.
# Find this in: Google Ads → Tools → Conversions → your "Purchase" action → Tag setup
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=your_conversion_label_here

# [CLIENT PUBLIC] GA4 Measurement ID — REQUIRED for remarketing audiences,
# behavior flow analysis, and audience signals for Performance Max campaigns.
# Create a GA4 property at https://analytics.google.com → Admin → Create Property
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 6. Meta Ads Pixel (Facebook & Instagram Tracking)
# ------------------------------------------------------------------------------
# [CLIENT PUBLIC] Meta Pixel / Dataset ID for standard events (PageView, ViewContent, InitiateCheckout, Purchase)
NEXT_PUBLIC_META_PIXEL_ID=1773518093991339

# ------------------------------------------------------------------------------
# 7. Public Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
